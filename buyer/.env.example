# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
# PRIORS_WALLET_ADDRESS  — Priors' EVM address, shown on its agent page.
# PRIORS_WALLET_ID       — Privy wallet id (UUID), from the Signers tab.
# PRIORS_SIGNER_PRIVATE_KEY
#                        — Privy *authorization key*, NOT an EOA key.
#                          base64 PKCS#8 P-256, ~155 chars, starts with `MIGH`.
#                          Generated via "Add a signer" on the agent page.
#
# Gas is sponsored by Virtuals' paymaster on Base, so this wallet needs USDC
# for the job amount and no ETH.

PRIORS_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
PRIORS_WALLET_ID=00000000-0000-0000-0000-000000000000
PRIORS_SIGNER_PRIVATE_KEY=MIGH...replace-with-your-base64-pkcs8-p256-key...

# The provider to hire. Defaults to Digest.
PROVIDER_ADDRESS=0x5043147b8b666ac070e01ff659e1fbbbc2462bc7
