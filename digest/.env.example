# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
# SELLER_WALLET_ADDRESS  — Digest's EVM address, shown on its agent page.
# SELLER_WALLET_ID       — Privy wallet id (UUID), from the Signers tab.
# SELLER_SIGNER_PRIVATE_KEY
#                        — Privy *authorization key*, NOT an EOA key.
#                          base64 PKCS#8 P-256, ~155 chars, starts with `MIGH`.
#                          Generated via "Add a signer" on the agent page.

SELLER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
SELLER_WALLET_ID=00000000-0000-0000-0000-000000000000
SELLER_SIGNER_PRIVATE_KEY=MIGH...replace-with-your-base64-pkcs8-p256-key...

# Optional. Without it Digest still delivers, using extractive summarisation.
ANTHROPIC_API_KEY=
